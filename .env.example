ASSISTANT_DEEPSEEK_URL=https://api.deepseek.com
ASSISTANT_DEEPSEEK_MODEL=deepseek-flash
# Set ASSISTANT_DEEPSEEK_API_KEY in the process environment, not in this tracked file.
ASSISTANT_DATABASE_URL=sqlite:///./data/assistant.db
ASSISTANT_LOG_LEVEL=INFO
# Segundos: tiempo máximo por llamada a herramienta y validez del lease de la tarea.
# Son los valores por defecto del código; súbelos si tus comandos de shell o de
# tests tardan más que eso.
ASSISTANT_TOOL_TIMEOUT=60
ASSISTANT_LEASE_SECONDS=300
ASSISTANT_DEEPSEEK_TIMEOUT=600
ASSISTANT_DEEPSEEK_TEMPERATURE=0.1
ASSISTANT_DEEPSEEK_THINKING=true
ASSISTANT_DEEPSEEK_REASONING_POLICY=ORCHESTRATOR:high,AGENT:high,PLANNER:high,NODE_RESOLVER:low,REPLANNER:high,VERIFIER:off,FINAL_RESPONSE:low
ASSISTANT_DEEPSEEK_MAX_TOKENS=16384
ASSISTANT_DEEPSEEK_MAX_PROMPT_CHARS=400000
ASSISTANT_DEEPSEEK_MAX_RESPONSE_CHARS=250000
ASSISTANT_DEEPSEEK_FAILURE_THRESHOLD=3
ASSISTANT_DEEPSEEK_RECOVERY_TIMEOUT=30
ASSISTANT_TASK_MAX_EXECUTION_TIME=7200
ASSISTANT_FINAL_RESPONSE_TIMEOUT=900
ASSISTANT_TASK_MAX_STEPS=200
ASSISTANT_WORKSPACE_ROOT=C:/projects/Assistant
ASSISTANT_PROJECTS_ROOT=C:/projects

# Explicit user profile. This is persisted in SQLite as one user_profile object.
# These three flags decide what the startup collects and persists; set them to
# false to keep the host facts, host checks or profile out of the database.
ASSISTANT_COLLECT_SYSTEM_FACTS=true
ASSISTANT_PERSIST_SYSTEM_FACTS=true
ASSISTANT_PERSIST_USER_PROFILE=true
ASSISTANT_USER_NAME=Alfonso Villar Garcia
ASSISTANT_USER_BIRTH_DATE=1997-01-08
ASSISTANT_USER_PROFESSION=Programador
ASSISTANT_USER_DEGREES=Grado en Matematicas,Grado en Ingenieria Informatica
ASSISTANT_USER_EXPERTISE=Experto

# --- Display, contexts and attachments -------------------------------------
# Human-facing model name. The API id stays in ASSISTANT_DEEPSEEK_MODEL.
ASSISTANT_DEEPSEEK_MODEL_LABEL=DeepSeek V4.1 Flash
# Readiness is reused for this many seconds instead of calling /models every pass.
ASSISTANT_DEEPSEEK_READY_CACHE_SECONDS=60
# Streaming enables time-to-first-token metrics (needs an SSE-capable endpoint).
ASSISTANT_DEEPSEEK_STREAM_RESPONSES=false
# Set true only if the configured model can actually read image bytes.
# Vision: deepseek-flash (DeepSeek-V4.1-Flash) SI acepta imagenes; deepseek-v4-pro no.
# Formatos: JPEG, PNG, GIF, WebP (se detecta el contenido, no la extension). Las
# imagenes solo valen en mensajes de usuario; en system/assistant dan 400.
# Coste: cada imagen se reescala a ~1300x1300 equivalentes y cuesta como maximo
# 1024 tokens. base64 cuenta en el limite de 48 MiB por peticion (max 32 MiB por
# imagen, 600 imagenes por peticion).
ASSISTANT_DEEPSEEK_SUPPORTS_VISION=true
# Captura fresca + adjunto: 2 imagenes por peticion como maximo (<= 2048 tokens).
ASSISTANT_VISION_MAX_IMAGES=2
# low = reescala a 512x512 antes de inferir (mas rapido y barato); original/high
# mantienen la imagen, que es lo que hace falta para leer texto de una captura.
ASSISTANT_VISION_DETAIL=original
ASSISTANT_ATTACHMENT_MAX_BYTES=5000000
ASSISTANT_ATTACHMENT_MAX_COUNT=4
# --- Presupuestos y contexto ---------------------------------------------------
# Tope duro de un prompt. La ventana real la pone el modelo; esto es el cinturon
# que evita enviar un contexto desbocado a cualquier precio (~400000 chars ~ 100k tokens).
# Evidencia (caracteres) por turno de agente/orquestador. Si el contexto cabe,
# NO se recorta nada; si no cabe, se recortan primero los datos volatiles.
ASSISTANT_AGENT_CONTEXT_CHARS=200000
# Presupuestos por tarea. Los aplica el ledger (_consume_budget) y agotan la
# tarea con BUDGET_EXHAUSTED, asi que un tope bajo corta trabajo util a medias.
ASSISTANT_TASK_MAX_LLM_CALLS=60
ASSISTANT_TASK_MAX_TOOL_CALLS=150
ASSISTANT_TASK_MAX_CODEGRAPH_QUERIES=200
ASSISTANT_TASK_MAX_PROJECT_READS=200
ASSISTANT_TASK_MAX_SOURCE_BYTES=60000000
ASSISTANT_TASK_MAX_PLAN_NODES=200
ASSISTANT_TASK_MAX_RETRIES=3
ASSISTANT_TASK_MAX_RECOVERY_ATTEMPTS=3
# Consultas semanticas (types.hover/definition/references) via servidor LSP de
# pyright. Vacio = autodeteccion: variable de entorno, cache de npx, o global.
ASSISTANT_PYRIGHT_LANGSERVER=
ASSISTANT_SEMANTIC_TIMEOUT_SECONDS=60

# --- Contexto e indice estructural -------------------------------------------
# Presupuesto de evidencia (caracteres) de un turno de agente/orquestador. El
# catalogo de herramientas NUNCA se sustituye ni se recorta en silencio; solo se
# recortan datos volatiles, en orden fijo, para no mover el prefijo cacheable.
# El tope duro del prompt sigue siendo ASSISTANT_DEEPSEEK_MAX_PROMPT_CHARS.
# Limites del indice estructural (codegraph). Topes mas altos = un build mas
# lento y un JSON persistido mayor, pero respuestas utiles en proyectos grandes.
ASSISTANT_CODEGRAPH_MAX_FILES=2000
ASSISTANT_CODEGRAPH_MAX_SYMBOLS=6000
ASSISTANT_CODEGRAPH_MAX_EDGES=20000
# Segundos que un codegraph se reutiliza si el arbol del proyecto no cambio
# (huella por ruta+tamano+mtime). 0 = reanalizar antes de cada fase LLM.
ASSISTANT_CODEGRAPH_REFRESH_SECONDS=300

# --- Throughput -------------------------------------------------------------
# Independent tasks advancing in parallel. 1 = strictly sequential (default).
ASSISTANT_MAX_CONCURRENT_TASKS=1

# --- Cost -------------------------------------------------------------------
# USD per 1,000,000 tokens. Empty = no cost is reported (never guessed).
# Example: {"deepseek-flash": {"input": 0.28, "cached_input": 0.028, "output": 0.42}}
ASSISTANT_MODEL_PRICING=

# --- Ahorro de consumo (off-peak) -------------------------------------------
# DeepSeek peak hours are 01:00-04:00 and 06:00-10:00 UTC, Mon-Fri (half price
# outside them). When enabled, the queue is held during peak windows.
ASSISTANT_OFFPEAK_SAVINGS_DEFAULT=false
# ISO dates treated as Chinese public holidays (off-peak all day). Fill from the
# official calendar, e.g. 2026-10-01,2026-10-02.
ASSISTANT_CN_HOLIDAYS=

# --- Trabajo recurrente -----------------------------------------------------
# Timezone for daily schedules when the caller does not name one. Use an IANA
# name (Europe/Madrid) or a fixed offset (UTC+02:00). Named zones need the
# 'tzdata' package, since Windows ships no system timezone database.
ASSISTANT_SCHEDULE_TIMEZONE=UTC

# --- Runtime y mantenimiento -------------------------------------------------
# Bucle de mantenimiento en segundo plano; pausarlo no cancela trabajo.
ASSISTANT_IDLE_ENABLED=true
ASSISTANT_MAINTENANCE_INTERVAL=300
# La serie temporal de métricas se calcula desde los eventos retenidos: si
# reduces la retención, la serie se acorta. Se conservan siempre los últimos N.
ASSISTANT_EVENT_RETENTION_DAYS=30
ASSISTANT_EVENT_RETENTION_KEEP_RECENT=1000

# --- Unattended-operation policy --------------------------------------------
# Comma-separated. Empty = no restriction.
ASSISTANT_TOOL_DENYLIST=
ASSISTANT_TOOL_METHOD_DENYLIST=
# Regex allowlist for shell/deployment commands, e.g. ^pytest\b,^python -m
ASSISTANT_SHELL_COMMAND_ALLOWLIST=
# Filesystem jail, e.g. C:/projects,C:/Assistant
ASSISTANT_FILESYSTEM_ALLOWED_ROOTS=
# Pacing entre llamadas a la misma herramienta, como pares "tool=segundos":
# http=1,web=1,shell=2. Vacío = sin límite.
ASSISTANT_TOOL_RATE_LIMITS=
# Mouse/keyboard control can type into any window: opt-in only.
ASSISTANT_ENABLE_INPUT_CONTROL=false
